# Public application origin used for strict Origin validation on cookie-authenticated writes.
APP_ORIGIN=http://localhost:3000

# Supabase project URL and server-only secret key. Never prefix the secret with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Optional release identifier surfaced by the liveness endpoint.
VERCEL_GIT_COMMIT_SHA=local
